# ================================================
# NP POWER TECH SOLAR - Backend Environment Template
# ================================================
# Copy this file to .env and fill in REAL values.
# NEVER commit the .env file.
# NEVER put real secrets in this template file.

# ---------- Server ----------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8080

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=np_power_tech_solar
DB_USER=np_solar_user
DB_PASSWORD=parth@123
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT / Auth ----------
JWT_ACCESS_SECRET=dev_access_secret_aBcDeF1234567890xYzAbCdEf1234567890
JWT_REFRESH_SECRET=dev_refresh_secret_ZyXwVu9876543210TsRqPoNmLk9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------- File Storage ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../storage/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=NP POWER TECH SOLAR
SMTP_FROM_EMAIL=

# ---------- WhatsApp ----------
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------- Payment Gateway ----------
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---------- Logging ----------
LOG_LEVEL=info
LOG_DIR=./logs

# ---------- Security ----------
BCRYPT_ROUNDS=12
HELMET_ENABLED=true
