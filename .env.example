# ================================================
# NP POWER TECH SOLAR - Root Environment Template
# ================================================
# This is a REFERENCE template for the whole monorepo.
# The real .env files live inside backend-node/ and frontend-python/.
# NEVER commit real .env files.

# ---------- Postgres (for docker-compose) ----------
POSTGRES_DB=np_power_tech_solar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ---------- Redis (for docker-compose) ----------
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IF_REQUIRED

# ---------- Backend ----------
BACKEND_PORT=3000
NODE_ENV=development

# ---------- Frontend ----------
FRONTEND_PORT=8080
APP_ENV=development