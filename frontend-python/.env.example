# ================================================
# NP POWER TECH SOLAR - Frontend Environment Template
# ================================================
# Copy this file to .env and fill in REAL values.
# NEVER commit the .env file.
# Frontend MUST NOT contain database credentials or backend secrets.

# ---------- App ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TITLE=NP POWER TECH SOLAR

# ---------- Backend API ----------
BACKEND_API_BASE_URL=http://localhost:3000
BACKEND_API_TIMEOUT=30

# ---------- Public Config (safe to expose) ----------
PUBLIC_COMPANY_NAME=NP POWER TECH SOLAR
PUBLIC_COMPANY_PHONE=
PUBLIC_COMPANY_EMAIL=
PUBLIC_COMPANY_WHATSAPP=
PUBLIC_COMPANY_ADDRESS=

# ---------- i18n ----------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi
