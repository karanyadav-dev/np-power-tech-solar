# ==========================================
# NP POWER TECH SOLAR - Git Ignore Rules
# ==========================================

# ---------- Environment ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/
*.tsbuildinfo

# ---------- Logs ----------
logs/
*.log
npm-debug.log*

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Storage / Uploads ----------
storage/uploads/*
!storage/uploads/.gitkeep
storage/temp/*
!storage/temp/.gitkeep

# ---------- Backend specific ----------
backend-node/logs/*
!backend-node/logs/.gitkeep

# ---------- Database dumps ----------
*.sql.gz
*.dump
backups/

# ---------- Build artifacts ----------
.next/
out/
dist/

# ---------- Secrets (extra safety) ----------
*.pem
*.key
secrets/