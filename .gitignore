# ================================================
# NP POWER TECH SOLAR - .gitignore
# ================================================

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache
coverage/
dist/
build/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ---------- Environment / Secrets ----------
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
*.pem
*.key
secrets/
config/secrets.*

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Storage / Uploads ----------
storage/uploads/*
!storage/uploads/.gitkeep
!storage/uploads/**/.gitkeep
storage/temp/*
!storage/temp/.gitkeep

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE / Editor ----------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ---------- Build / Cache ----------
.cache/
.temp/
tmp/
temp/

# ---------- Database ----------
*.sqlite
*.sqlite3
*.db
database/backups/
database/dumps/

# ---------- Testing ----------
/test-results/
/playwright-report/
/allure-results/
